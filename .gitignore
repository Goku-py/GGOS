# Build output and release artifacts.
# The packaged playbook is attached to a GitHub Release, not committed:
# Build-Playbook.ps1 writes dist/GGOS-v<version>.apbx.
dist/
*.apbx

# Maintainer tooling and non-shipped material - kept locally, never committed.
# (Packaging script, helper build step + source pin, CLI smoke harness,
#  historical docs. The released .apbx contains only playbook content.)
Build-Playbook.ps1
Build-Playbook.cmd
Native/
tools/
docs/
timer-hash.txt

# Native helper build output (the shipped binary lives in Executables/)
Native/bin/
Native/obj/
Native/*.exe
Native/*.pdb

# OS metadata
Thumbs.db
desktop.ini
.DS_Store

# Editor / IDE
.vscode/
.idea/
.vs/
*.swp
*.swo

# Local logs and scratch files
*.log
*.tmp
*.bak
